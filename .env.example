# FitForge AI Configuration

# Option A: Google AI Studio API Key (recommended for quick local testing)
GEMINI_API_KEY=your_gemini_api_key_here

# Option B: Vertex AI & Google Cloud Secret Manager (for production / GCP deployment)
GOOGLE_CLOUD_PROJECT=your_gcp_project_id
GOOGLE_CLOUD_LOCATION=us-central1

# Local Persistent Storage
FITFORGE_DB_PATH=fitforge_memory.db

# OpenTelemetry Tracing & Logging
FITFORGE_LOG_JSON=true
FITFORGE_LOG_LEVEL=INFO
